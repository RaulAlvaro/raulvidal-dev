---
// A product walkthrough: a browser frame of real screens beside the chapters they illustrate.
// On desktop the page script pins it and scroll plays the screens (see setupWalk in
// portafolio.astro); on phones and under reduced motion it is a native swipe carousel.
import TrafficLights from './TrafficLights.astro';

interface Screen {
  img: ImageMetadata;
  /** Modals fade in over the page they belong to; pages crossfade in with a slight zoom. */
  kind: 'page' | 'modal';
}

interface Chapter {
  title: string;
  body: string;
  /** Optional headline figure shown with the chapter, e.g. "11.500+". */
  stat?: string;
  screens: Screen[];
}

interface Props {
  /** Product name, used in the screens' alt text. */
  name: string;
  /** Address shown in the browser bar. */
  address: string;
  chapters: Chapter[];
}

const { name, address, chapters } = Astro.props;
const screens = chapters.flatMap((chapter, c) => chapter.screens.map((screen) => ({ ...screen, chapter: c, chapterTitle: chapter.title })));
const total = String(screens.length).padStart(2, '0');
---

<div class="walk" data-walk>
  <div class="walk__story">
    <ol class="chapters">
      {chapters.map((chapter, i) => (
        <li class={`chapter${i === 0 ? ' is-active' : ''}`} data-chapter>
          <h3><span class="mono chapter__num">{String(i + 1).padStart(2, '0')}</span>{chapter.title}</h3>
          <div class="chapter__body">
            {chapter.stat && <span class="chapter__stat">{chapter.stat}</span>}
            <p>{chapter.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="walk__meter">
      <p class="mono"><span data-screen-num>01</span> / {total}</p>
      <div class="progress" aria-hidden="true"><span data-progress></span></div>
    </div>
  </div>

  <div class="browser">
    <div class="browser__bar" aria-hidden="true">
      <TrafficLights />
      <em class="mono">{address}</em>
    </div>
    <div class="browser__screens">
      {screens.map((screen, i) => (
        <figure class="screen" data-screen data-kind={screen.kind} data-chapter-index={screen.chapter}>
          <img
            src={screen.img.src}
            width={screen.img.width}
            height={screen.img.height}
            alt={`${name}, ${screen.chapterTitle}: pantalla ${i + 1} de ${screens.length}`}
            decoding="async"
          />
        </figure>
      ))}
    </div>
    <p class="mono browser__swipe">desliza → · {screens.length} pantallas</p>
  </div>
</div>

<style>
  .walk {
    max-width: 84rem;
    margin-inline: auto;
    padding: 1.5rem var(--content-pad);
    display: grid;
    grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    height: calc(100svh - 72px);
    box-sizing: border-box;
  }

  .walk__story {
    display: grid;
    gap: 2.5rem;
    align-content: center;
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
  }

  /* The body collapses through a 0fr → 1fr grid row, so opening a chapter never animates height. */
  .chapter {
    display: grid;
    grid-template-rows: auto 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chapter h3 {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    margin: 0;
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--color-ink-faint);
    transition: color 0.4s ease;
  }

  .chapter__num {
    color: inherit;
    font-size: 0.72rem;
  }

  .chapter__body {
    min-height: 0;
    overflow: hidden;
    padding-left: 2.15rem;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .chapter__stat {
    display: block;
    padding-top: 0.6rem;
    font-weight: 300;
    font-size: 2.4rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .chapter p {
    margin: 0;
    padding-top: 0.6rem;
    color: var(--color-ink-dim);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .chapter.is-active {
    grid-template-rows: auto 1fr;
  }

  .chapter.is-active h3 {
    color: var(--color-ink);
  }

  .chapter.is-active .chapter__num {
    color: var(--color-accent);
  }

  .chapter.is-active .chapter__body {
    opacity: 1;
  }

  .walk__meter {
    display: grid;
    gap: 0.75rem;
  }

  .walk__meter p {
    margin: 0;
  }

  .progress {
    height: 1px;
    background: var(--color-rule);
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform-origin: left;
  }

  .browser {
    width: min(100%, (100svh - 72px - 6rem) * 1.75);
    justify-self: center;
    border: 1px solid var(--color-rule);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-bg-raised);
    box-shadow: 0 50px 80px -40px rgb(0 0 0 / 0.8);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .browser__bar em {
    font-style: normal;
    margin: 0 auto;
    padding-right: 3rem;
    color: var(--color-ink-dim);
    font-size: 0.72rem;
  }

  .browser__screens {
    position: relative;
    aspect-ratio: 1600 / 874;
    background: #0b0b14;
  }

  .screen {
    position: absolute;
    inset: 0;
    margin: 0;
    will-change: opacity, transform;
  }

  .screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* Only shown where the walkthrough is a swipe carousel (phones, reduced motion). */
  .browser__swipe {
    display: none;
    margin: 0;
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink-dim);
  }

  /* Reduced motion: no pin; every chapter open and the screens become a swipe carousel. */
  :global(.is-static) .walk {
    height: auto;
    grid-template-columns: 1fr;
  }

  :global(.is-static) .chapter {
    grid-template-rows: auto 1fr;
  }

  :global(.is-static) .chapter h3 {
    color: var(--color-ink);
  }

  :global(.is-static) .chapter__body {
    opacity: 1;
  }

  :global(.is-static) .walk__meter {
    display: none;
  }

  :global(.is-static) .browser__screens {
    aspect-ratio: auto;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  :global(.is-static) .screen {
    position: static;
    flex: none;
    width: 100%;
    scroll-snap-align: start;
  }

  :global(.is-static) .browser__swipe {
    display: block;
  }

  @media (max-width: 800px) {
    .walk {
      grid-template-columns: 1fr;
      height: auto;
      gap: 1.5rem;
    }

    .walk__story {
      order: 2;
      gap: 1.5rem;
    }

    .chapter {
      grid-template-rows: auto 1fr;
    }

    .chapter h3 {
      color: var(--color-ink);
    }

    .chapter__body {
      opacity: 1;
    }

    .walk__meter {
      display: none;
    }

    .browser__screens {
      aspect-ratio: auto;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .screen {
      position: static;
      flex: none;
      width: 100%;
      scroll-snap-align: start;
    }

    .browser__swipe {
      display: block;
    }
  }
</style>
