---
import type { Locale } from '../i18n/content';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<div class="terminal" data-terminal>
  <div class="terminal__titlebar">
    <span class="terminal__dot terminal__dot--red" aria-hidden="true"></span>
    <span class="terminal__dot terminal__dot--yellow" aria-hidden="true"></span>
    <span class="terminal__dot terminal__dot--green" aria-hidden="true"></span>
  </div>
  <div class="terminal__body" data-terminal-body>
    <p class="terminal__line terminal__line--hint">{strings.terminal.helpHint}</p>
  </div>
  <div class="terminal__input-row">
    <span class="terminal__prompt" aria-hidden="true">$</span>
    <span class="terminal__field">
      <input
        type="text"
        class="terminal__input"
        data-terminal-input
        placeholder={strings.terminal.placeholder}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Terminal command input"
      />
      <span class="terminal__caret" aria-hidden="true"></span>
    </span>
  </div>
</div>

<script define:vars={{ locale, strings: t(locale).terminal }}>
  const root = document.currentScript.previousElementSibling;
  const body = root.querySelector('[data-terminal-body]');
  const input = root.querySelector('[data-terminal-input]');
  const REFOCUS_KEY = 'terminal:refocus';

  // Restore focus only when arriving from a `lang` switch, never on a plain load or refresh.
  try {
    if (sessionStorage.getItem(REFOCUS_KEY)) {
      sessionStorage.removeItem(REFOCUS_KEY);
      input.focus({ preventScroll: true });
    }
  } catch (e) {}

  // Bare arguments typed as commands: point to the full form instead of guessing.
  const SUGGESTIONS = { light: 'theme light', dark: 'theme dark', en: 'lang en', es: 'lang es' };

  function fmt(template, replacements) {
    return template.replace(/\{(\w+)\}/g, (_, key) => replacements[key] ?? '');
  }

  function appendLine(text, variant) {
    const p = document.createElement('p');
    p.className = 'terminal__line' + (variant ? ` terminal__line--${variant}` : '');
    p.textContent = text;
    body.appendChild(p);
    body.scrollTop = body.scrollHeight;
  }

  function appendCommandEcho(cmd) {
    const p = document.createElement('p');
    p.className = 'terminal__line terminal__line--echo';
    p.textContent = `$ ${cmd}`;
    body.appendChild(p);
    body.scrollTop = body.scrollHeight;
  }

  function runCommand(raw) {
    const cmd = raw.trim();
    if (!cmd) return;
    appendCommandEcho(cmd);

    const [name, ...args] = cmd.split(/\s+/);
    const lower = name.toLowerCase();

    if (isRootWipe(cmd)) {
      runRootWipe(cmd);
      return;
    }

    switch (lower) {
      case 'help':
        strings.help.forEach((line) => appendLine(line));
        break;
      case 'whoami':
        strings.whoami.forEach((line) => appendLine(line));
        break;
      case 'git':
        if (args[0] === 'log') {
          strings.gitLog.forEach((line) => appendLine(line));
        } else {
          appendLine(fmt(strings.commandNotFound, { cmd }));
        }
        break;
      case 'contact':
        strings.contact.forEach((line) => appendLine(line, 'accent'));
        break;
      case 'sudo':
        appendLine(strings.sudo);
        break;
      case 'lang': {
        const target = (args[0] || '').toLowerCase();
        if (target === 'en' || target === 'es') {
          appendLine(fmt(strings.langSwitching, { lang: target }));
          setTimeout(() => {
            try {
              sessionStorage.setItem(REFOCUS_KEY, '1');
            } catch (e) {}
            const path = target === 'en' ? '/' : '/es/';
            window.location.href = path;
          }, 500);
        } else if (!target) {
          appendLine(fmt(strings.langUsage, { example: locale === 'en' ? 'es' : 'en' }));
        } else {
          appendLine(fmt(strings.langUnknown, { lang: target }));
        }
        break;
      }
      case 'theme': {
        const target = (args[0] || '').toLowerCase();
        if (target === 'light' || target === 'dark') {
          window.__theme?.apply(target);
          appendLine(fmt(strings.themeSwitched, { theme: target }));
        } else if (!target) {
          const current = window.__theme?.current() ?? 'dark';
          appendLine(fmt(strings.themeCurrent, { theme: current }));
          appendLine(fmt(strings.themeUsage, { example: current === 'dark' ? 'light' : 'dark' }));
        } else {
          appendLine(fmt(strings.themeUnknown, { theme: target }));
        }
        break;
      }
      case 'clear':
        clearTerminal();
        break;
      default:
        if (SUGGESTIONS[lower] && args.length === 0) {
          appendLine(fmt(strings.didYouMean, { cmd, suggestion: SUGGESTIONS[lower] }));
        } else {
          appendLine(fmt(strings.commandNotFound, { cmd }));
        }
    }
  }

  function clearTerminal() {
    body.innerHTML = '';
  }

  // ─── Easter egg: `sudo rm -rf /*` wipes the page and drops into a GRUB shell. ───
  // Deliberately absent from `help`. System output stays in English, like the real tools.

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms) => new Promise((resolve) => setTimeout(resolve, reducedMotion ? Math.min(ms, 60) : ms));

  function parseRm(cmd) {
    const tokens = cmd.split(/\s+/);
    const sudo = tokens[0] === 'sudo';
    const rest = sudo ? tokens.slice(1) : tokens;
    if (rest[0] !== 'rm') return null;
    const shortFlags = rest.filter((t) => /^-[a-zA-Z]+$/.test(t)).join('');
    return {
      sudo,
      recursive: /[rR]/.test(shortFlags),
      force: shortFlags.includes('f'),
      noPreserveRoot: rest.includes('--no-preserve-root'),
      targets: rest.slice(1).filter((t) => !t.startsWith('-')),
    };
  }

  function isRootWipe(cmd) {
    const rm = parseRm(cmd);
    return Boolean(rm && rm.recursive && rm.force && rm.targets.some((t) => t === '/' || t === '/*'));
  }

  function runRootWipe(cmd) {
    const rm = parseRm(cmd);
    // GNU rm refuses a bare `/` unless told otherwise; `/*` expands past the failsafe.
    if (rm.targets.includes('/') && !rm.noPreserveRoot) {
      appendLine("rm: it is dangerous to operate recursively on '/'");
      appendLine('rm: use --no-preserve-root to override this failsafe');
      return;
    }
    if (!rm.sudo) {
      ['/bin', '/boot', '/etc'].forEach((dir) => appendLine(`rm: cannot remove '${dir}': Permission denied`));
      return;
    }
    crash();
  }

  const WIPED_FILES = [
    '/boot/grub/grub.cfg',
    '/boot/vmlinuz-6.8.0-deepin',
    '/etc/fstab',
    '/usr/bin/node',
    '/usr/lib/node_modules',
    '/home/raul/.ssh/id_ed25519',
    '/home/raul/cv/impact-cases',
    '/home/raul/cv/experience',
    '/home/raul/cv/tech-stack',
    '/home/raul/cv/education',
    '/home/raul/.bash_history',
    '/var/www/raulvidal.dev',
  ];

  async function crash() {
    input.disabled = true;
    for (const file of WIPED_FILES) {
      appendLine(`removed '${file}'`, 'hint');
      await wait(55);
    }

    const html = document.documentElement;
    html.classList.add('is-crashing');
    await wait(650);

    const sections = [...document.querySelectorAll('main > *')].reverse();
    for (const section of sections) {
      section.classList.add('is-wiped');
      await wait(110);
    }
    await wait(500);
    openGrub();
  }

  function reboot() {
    const html = document.documentElement;
    html.classList.remove('is-crashing');
    document.querySelectorAll('.is-wiped').forEach((el) => el.classList.remove('is-wiped'));
    input.disabled = false;
    clearTerminal();
    appendLine(strings.rebooted, 'accent');
    input.focus({ preventScroll: true });
  }

  const GRUB_PARTITIONS =
    '(hd0) (hd0,msdos5) (hd0,msdos1) (hd1) (hd1,msdos7) (hd1,msdos6) (hd1,msdos5) (hd1,msdos1) (fd0)';
  const GRUB_COMMANDS = ['clear', 'exit', 'help', 'insmod', 'ls', 'normal', 'reboot', 'set'];

  function openGrub() {
    const overlay = document.createElement('div');
    overlay.className = 'grub';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', 'GNU GRUB shell');
    overlay.innerHTML = `
      <p class="grub__title">GNU GRUB  version 2.02~beta2-15</p>
      <p class="grub__intro">Minimal BASH-like line editing is supported. For the first word, TAB lists possible command completions. Anywhere else TAB lists possible device or file completions.</p>
      <div class="grub__log"></div>
      <p class="grub__line"><span>grub&gt; </span><span class="grub__typed"></span><span class="grub__cursor">_</span></p>
      <input class="grub__input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="GRUB command" />
    `;
    document.body.appendChild(overlay);
    document.documentElement.classList.add('is-grub');

    const log = overlay.querySelector('.grub__log');
    const typed = overlay.querySelector('.grub__typed');
    const grubInput = overlay.querySelector('.grub__input');

    const print = (text) => {
      const line = document.createElement('p');
      line.className = 'grub__out';
      line.textContent = text;
      log.appendChild(line);
      overlay.scrollTop = overlay.scrollHeight;
    };

    const close = () => {
      overlay.remove();
      document.documentElement.classList.remove('is-grub');
      reboot();
    };

    const exec = (raw) => {
      print(`grub> ${raw}`);
      const [command, ...rest] = raw.trim().split(/\s+/);
      switch (command) {
        case '':
        case 'set':
        case 'insmod':
          break;
        case 'ls':
          print(rest.length ? `Partition ${rest[0].replace(/[()]/g, '')}: Filesystem type ext*` : GRUB_PARTITIONS);
          break;
        case 'help':
          print(GRUB_COMMANDS.join('  '));
          print('# what the youtube tutorial said:');
          print('#   set root=(hd0,msdos1)');
          print('#   set prefix=(hd0,msdos1)/boot/grub');
          print('#   insmod normal');
          print('#   normal');
          break;
        case 'clear':
          log.innerHTML = '';
          overlay.querySelector('.grub__intro')?.remove();
          overlay.querySelector('.grub__title')?.remove();
          break;
        case 'normal':
        case 'reboot':
        case 'exit':
          close();
          return;
        default:
          print(`error: can't find command \`${command}'.`);
      }
    };

    grubInput.addEventListener('input', () => {
      typed.textContent = grubInput.value;
    });

    grubInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const value = grubInput.value;
        grubInput.value = '';
        typed.textContent = '';
        exec(value);
      } else if (e.key === 'Tab') {
        e.preventDefault();
        print(`grub> ${grubInput.value}`);
        print('Possible commands are:');
        print(`  ${GRUB_COMMANDS.join(' ')}`);
      } else if (e.key === 'Escape') {
        close();
      }
    });

    overlay.addEventListener('click', () => grubInput.focus({ preventScroll: true }));
    grubInput.focus({ preventScroll: true });
  }

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      runCommand(input.value);
      input.value = '';
      return;
    }
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'l') {
      e.preventDefault();
      clearTerminal();
    }
  });

  root.addEventListener('click', () => input.focus());
</script>

<style>
  .terminal {
    width: 100%;
    max-width: 40rem;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .terminal__titlebar {
    display: flex;
    gap: 0.5rem;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-rule);
  }

  .terminal__dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--color-ink-faint);
  }

  .terminal__dot--red {
    background: #ff5f57;
  }

  .terminal__dot--yellow {
    background: #febc2e;
  }

  .terminal__dot--green {
    background: #28c840;
  }

  .terminal__body {
    padding: var(--space-4);
    height: 18rem;
    overflow-x: hidden;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .terminal__line {
    margin: 0;
    min-width: 0;
    color: var(--color-ink);
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .terminal__line--hint {
    color: var(--color-ink-dim);
  }

  .terminal__line--echo {
    color: var(--color-accent);
  }

  .terminal__line--accent {
    color: var(--color-accent);
  }

  .terminal__input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-rule);
  }

  .terminal__prompt {
    color: var(--color-accent);
  }

  .terminal__field {
    position: relative;
    flex: 1;
    display: flex;
    font-size: 0.85rem;
  }

  .terminal__input {
    flex: 1;
    min-width: 0;
    padding: 0;
    background: none;
    border: none;
    color: var(--color-ink);
    caret-color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: inherit;
    outline: none;
  }

  .terminal__input::placeholder {
    color: var(--color-ink-dim);
    opacity: 1;
  }

  /* Idle block cursor: signals "type here" while the input is empty and unfocused.
     It sits over the placeholder's leading non-breaking space, so nothing shifts on focus. */
  .terminal__caret {
    position: absolute;
    left: 0;
    top: 50%;
    width: 1ch;
    height: 1.2em;
    font-family: var(--font-mono);
    background: var(--color-accent);
    transform: translateY(-50%);
    pointer-events: none;
    animation: terminal-caret-blink 1.1s steps(1) infinite;
  }

  .terminal__input:focus + .terminal__caret,
  .terminal__input:not(:placeholder-shown) + .terminal__caret {
    display: none;
  }

  @keyframes terminal-caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__caret {
      animation: none;
    }
  }
</style>

<style is:global>
  /* Easter egg: page crash + GRUB shell (see crash() in HeroTerminal). An emulated
     VGA console, so it ignores the site palette and theme on purpose. */
  html.is-crashing main {
    animation: crash-glitch 0.65s steps(1) both;
  }

  html.is-crashing main > * {
    transition: clip-path 0.12s ease-in, opacity 0.12s ease-in;
  }

  html.is-crashing main > .is-wiped {
    clip-path: inset(0 0 100% 0);
    opacity: 0;
  }

  @keyframes crash-glitch {
    0% {
      transform: none;
    }
    12% {
      transform: translate(-7px, 0) skewX(3deg);
      filter: hue-rotate(90deg) saturate(3);
      clip-path: inset(12% 0 58% 0);
    }
    24% {
      transform: translate(9px, -3px);
      filter: invert(1);
      clip-path: inset(46% 0 18% 0);
    }
    36% {
      transform: translate(-3px, 4px) skewX(-6deg);
      filter: none;
      clip-path: inset(0 0 72% 0);
    }
    48% {
      transform: translate(5px, 0);
      filter: hue-rotate(-120deg) contrast(2);
      clip-path: inset(30% 0 30% 0);
    }
    60% {
      transform: translate(-10px, 2px);
      filter: invert(1) hue-rotate(45deg);
      clip-path: none;
    }
    72% {
      transform: translate(2px, -2px) skewX(8deg);
      filter: contrast(3);
      clip-path: inset(64% 0 4% 0);
    }
    84%,
    100% {
      transform: none;
      filter: none;
      clip-path: none;
    }
  }

  html.is-grub {
    overflow: hidden;
  }

  .grub {
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow-y: auto;
    padding: 2.5rem clamp(1rem, 3vw, 2rem);
    background: #000;
    color: #aaa;
    font-family: 'DejaVu Sans Mono', Menlo, Consolas, ui-monospace, monospace;
    font-size: clamp(0.8rem, 1.6vw, 1.05rem);
    line-height: 1.35;
    cursor: text;
  }

  .grub p {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .grub__title {
    text-align: center;
    margin-bottom: 1.5em !important;
  }

  .grub__intro {
    max-width: 78ch;
    padding-inline: 2ch;
    margin-bottom: 2.5em !important;
  }

  .grub__cursor {
    animation: grub-cursor 1s steps(1) infinite;
  }

  @keyframes grub-cursor {
    50% {
      opacity: 0;
    }
  }

  /* Real input kept focusable (mobile keyboards) but invisible; .grub__typed mirrors it. */
  .grub__input {
    position: fixed;
    left: 0;
    bottom: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    border: 0;
    padding: 0;
    font-size: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    html.is-crashing main {
      animation: none;
    }

    html.is-crashing main > * {
      transition: none;
    }

    .grub__cursor {
      animation: none;
    }
  }
</style>
