---
import type { Locale } from '../i18n/content';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<section id="how-i-work" class="how-i-work" data-reveal>
  <div class="container">
    <h2 class="section-label">{strings.sections.howIWork}</h2>
    <hr class="hairline how-i-work__rule" />

    <div class="how-i-work__body">
      {strings.howIWorkBody.map((paragraph) => (
        <p class="how-i-work__paragraph">{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .how-i-work {
    padding-block: var(--space-16);
  }

  .how-i-work__rule {
    margin-block: var(--space-3) var(--space-12);
  }

  .how-i-work__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 44rem;
  }

  .how-i-work__paragraph {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0;
  }
</style>
