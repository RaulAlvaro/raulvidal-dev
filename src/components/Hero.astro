---
import type { Locale } from '../i18n/content';
import { getProfile } from '../i18n/content';
import { t } from '../i18n/ui';
import HeroTerminal from './HeroTerminal.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = await getProfile(locale);
const strings = t(locale);
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__topbar">
      <p class="hero__meta">
        {strings.docId} · STATUS: <span class="status-badge">{strings.status}</span>
      </p>
      <div class="hero__topbar-controls">
        <button type="button" class="hero__theme-toggle" data-theme-toggle aria-label={strings.themeToggleLabel}>
          <svg class="hero__theme-icon hero__theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
          <svg class="hero__theme-icon hero__theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
        <nav class="hero__locale" aria-label="Language">
          <span aria-hidden="true">[</span>
          <a href="/" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
          <span aria-hidden="true">|</span>
          <a href="/es/" aria-current={locale === 'es' ? 'true' : undefined}>ES</a>
          <span aria-hidden="true">]</span>
        </nav>
      </div>
    </div>
    <hr class="hairline hero__rule-top" />

    <div class="hero__body">
      <div class="hero__main">
        <h1 class="hero__headline">{profile.headline}</h1>
        <div class="hero__contact">
          <span class="hero__contact-row">{profile.name}</span>
          <span class="hero__contact-row"><a href={`mailto:${profile.email}`}>{profile.email}</a></span>
          <span class="hero__contact-row"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">{profile.linkedin.replace('https://', '')}</a></span>
          <span class="hero__contact-row"><a href={profile.github} target="_blank" rel="noopener noreferrer">{profile.github.replace('https://', '')}</a></span>
        </div>
        <div class="hero__actions">
          <a href={`mailto:${profile.email}`} class="hero__cta">{strings.contactCta} →</a>
          <button type="button" class="hero__cv" disabled title={strings.downloadComingSoon}>
            {strings.downloadCv}
          </button>
        </div>
      </div>

      <div class="hero__side">
        <HeroTerminal locale={locale} />
      </div>
    </div>

    <hr class="hairline hero__rule-bottom" />
    <p class="hero__scroll-hint">{strings.scrollHint}</p>
  </div>
</section>

<style>
  .hero {
    padding-inline: var(--content-pad);
    padding-block: var(--space-6);
    min-height: 100svh;
    display: flex;
  }

  .hero__inner {
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
  }

  .hero__topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .hero__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--color-ink-dim);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .hero__topbar-controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
    background: none;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-accent);
  }

  .hero__theme-toggle:hover,
  .hero__theme-toggle:focus-visible {
    border-color: var(--color-accent-dim);
  }

  .hero__theme-icon {
    width: 1rem;
    height: 1rem;
    display: none;
  }

  .hero__theme-icon--sun {
    display: block;
  }

  :root[data-theme='light'] .hero__theme-icon--sun {
    display: none;
  }

  :root[data-theme='light'] .hero__theme-icon--moon {
    display: block;
  }

  .hero__locale {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    display: flex;
    gap: var(--space-2);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .hero__locale a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .hero__locale a:hover,
  .hero__locale a:focus-visible {
    text-decoration: underline;
  }

  .hero__locale span {
    color: var(--color-ink-faint);
  }

  .hero__rule-top,
  .hero__rule-bottom {
    margin: 0;
  }

  .hero__body {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-16);
    align-items: center;
    padding-block: var(--space-12);
  }

  .hero__main {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  .hero__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .hero__cta {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-dim);
    padding: var(--space-3) var(--space-6);
    border-radius: 2px;
    white-space: nowrap;
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    background: var(--color-accent);
    color: var(--color-bg);
    text-decoration: none;
  }

  .hero__cv {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-faint);
    background: none;
    border: 1px solid var(--color-rule);
    padding: var(--space-3) var(--space-4);
    border-radius: 2px;
    cursor: not-allowed;
    white-space: nowrap;
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    border-left: 1px solid var(--color-rule);
    padding-left: var(--space-8);
    width: 32rem;
  }

  .hero__scroll-hint {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-dim);
    margin: 0;
    padding-top: var(--space-3);
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 0;
    }

    .hero__body {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding-block: var(--space-8);
    }

    .hero__side {
      border-left: none;
      padding-left: 0;
      width: auto;
    }
  }

  @media (max-width: 420px) {
    .hero__meta {
      font-size: 0.75rem;
      gap: 0.35rem;
    }
  }
</style>
